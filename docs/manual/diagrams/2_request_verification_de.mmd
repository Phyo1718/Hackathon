%% Antragsprüfung: Empfehlung des Agenten, Entscheidung der Sachbearbeitung
flowchart TB
  classDef agent fill:#E6F3F7,stroke:#0B99C4,stroke-width:1.5px,color:#45465A
  classDef human fill:#076A89,stroke:#076A89,color:#FFFFFF,font-weight:bold
  classDef doc fill:#F2F0EB,stroke:#6B6C7A,color:#45465A
  classDef locked fill:#FFFFFF,stroke:#A9A69E,stroke-width:1.5px,stroke-dasharray:6 4,color:#6B6C7A
  classDef step fill:#FFFFFF,stroke:#A9A69E,color:#45465A

  P1["Offenen Antrag öffnen<br/>(Antragsprüfung)"]:::step
  A1("AI · Empfehlung:<br/>Regelkonform · Prüfung erforderlich ·<br/>Nicht regelkonform"):::agent
  H1{"👤 Genehmigen<br/>oder Ablehnen?"}:::human
  H2["👤 Begründung im Vermerk<br/>(mind. 15 Zeichen)"]:::human
  S1["Im Antragsverlauf gespeichert,<br/>in der Aufsicht über den Agenten gezählt"]:::step
  A2("AI · Budget reicht nicht:<br/>Haushaltsposition mit<br/>freien Mitteln vorschlagen"):::agent
  D1@{ shape: doc, label: "Entwurf Deckungsantrag (PDF)" }
  H3["👤 Antrag unterschrieben,<br/>Budgetverschiebung angehakt"]:::human
  S2["Genehmigen: Budgets beider<br/>Positionen aktualisiert"]:::step

  P1 --> A1 --> H1
  H1 -- wie empfohlen --> S1
  H1 -- gegen die Empfehlung --> H2 --> S1
  A1 -. Budget reicht nicht .-> A2 --> D1 --> H3 --> S2 --> S1
  class D1 doc

  subgraph LEG["Legende"]
    direction LR
    G1("AI · Agent-Schritt"):::agent ~~~ G2["👤 Entscheidung Mensch"]:::human ~~~ G3@{ shape: doc, label: "Dokument / Ausgabe" } ~~~ G4["Gesperrt"]:::locked
  end
  class G3 doc
  %% Keep the legend below the flow
  S1 ~~~ LEG
