%% Award and rejection letters: approval, sending, status
flowchart TB
  classDef agent fill:#DBEAFE,stroke:#2563EB,stroke-width:1.5px,color:#0F172A
  classDef human fill:#1E3A8A,stroke:#1E3A8A,color:#FFFFFF,font-weight:bold
  classDef doc fill:#F1F5F9,stroke:#64748B,color:#0F172A
  classDef locked fill:#FFFFFF,stroke:#94A3B8,stroke-width:1.5px,stroke-dasharray:6 4,color:#475569
  classDef step fill:#FFFFFF,stroke:#94A3B8,color:#0F172A

  A1("AI · Award and rejection letters<br/>generated and stored with the evaluation"):::agent
  L1["✉ Email buttons locked"]:::locked
  H1["👤 Award approved<br/>(Freigabe erteilt)"]:::human
  D1@{ shape: doc, label: "Award letter<br/>to the recommended supplier" }
  D2@{ shape: doc, label: "Rejection letters (§ 46 UVgO)<br/>to all other bidders" }
  H2["👤 Send the email<br/>(any order)"]:::human
  H3["👤 Mark as sent"]:::human
  S1["Status in the history:<br/>Award sent / Rejection sent"]:::step

  A1 --> L1 --> H1
  H1 --> D1 & D2
  D1 & D2 --> H2 --> H3 --> S1
  class D1,D2 doc

  subgraph LEG["Legend"]
    direction LR
    G1("AI · Agent step"):::agent ~~~ G2["👤 Human decision"]:::human ~~~ G3@{ shape: doc, label: "Document / output" } ~~~ G4["Locked"]:::locked
  end
  class G3 doc
  %% Keep the legend below the flow
  S1 ~~~ LEG
