%% Wer entscheidet was: der Agent bereitet vor, der Mensch entscheidet
flowchart LR
  classDef agent fill:#E6F3F7,stroke:#0B99C4,stroke-width:1.5px,color:#45465A
  classDef human fill:#076A89,stroke:#076A89,color:#FFFFFF,font-weight:bold
  classDef doc fill:#F2F0EB,stroke:#6B6C7A,color:#45465A
  classDef locked fill:#FFFFFF,stroke:#A9A69E,stroke-width:1.5px,stroke-dasharray:6 4,color:#6B6C7A
  classDef step fill:#FFFFFF,stroke:#A9A69E,color:#45465A

  subgraph AG["AI · Agent bereitet vor"]
    A1("1 Antrag: prüft Budget, Lieferant,<br/>Barrierefreiheit; empfiehlt"):::agent
    A2("2 Budget: schlägt Haushaltsposition vor,<br/>füllt Deckungsantrag vor"):::agent
    A3("3 Angebote: liest PDFs aus,<br/>schlägt Punkte vor"):::agent
    A4("4 Wertung: berechnet Rangfolge<br/>und Preispunkte"):::agent
    A5("5 Schreiben: erstellt Zuschlags-<br/>und Absageschreiben"):::agent
    A6("6 Aufsicht: zählt Übereinstimmung<br/>und Abweichungen"):::agent
  end
  subgraph HU["👤 Mensch entscheidet"]
    H1["👤 Genehmigt oder lehnt ab;<br/>Abweichung mit Begründung"]:::human
    H2["👤 Unterschreibt den Antrag;<br/>Buchung nur mit Genehmigung"]:::human
    H3["👤 Kommission prüft, ändert<br/>und bestätigt die Punkte"]:::human
    H4["👤 Prüft das Ergebnis<br/>(Empfohlener Bieter)"]:::human
    H5["👤 Zuschlag freigegeben;<br/>versendet die E-Mails"]:::human
    H6["👤 Management prüft<br/>die Aufsicht über den Agenten"]:::human
  end
  A1 --> H1
  A2 --> H2
  A3 --> H3
  A4 --> H4
  A5 --> H5
  A6 --> H6

  subgraph LEG["Legende"]
    direction LR
    G1("AI · Agent-Schritt"):::agent ~~~ G2["👤 Entscheidung Mensch"]:::human ~~~ G3@{ shape: doc, label: "Dokument / Ausgabe" } ~~~ G4["Gesperrt"]:::locked
  end
  class G3 doc
