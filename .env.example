# Copy to .env and fill in. .env is ignored by git and by Docker builds (.dockerignore).

# Google Gemini API key (required). Used to read new procurement requests.
GEMINI_API_KEY=your-key-here

# Alternative name for the same key; only used if GEMINI_API_KEY is empty.
# GOOGLE_API_KEY=

# Optional: location of the SQLite database. history.json is stored next to it.
# The Docker image sets /app/data/mock_data.db (the persistent volume); locally the default
# is data/mock_data.db.
# PROCUREMENT_DB_PATH=

# Help assistant (floating chat button). Set to false to hide it completely.
ENABLE_CHAT=true
